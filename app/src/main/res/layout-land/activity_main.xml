<?xml version="1.0" encoding="utf-8"?>
<!--根布局：横屏使用水平LinearLayout，左右分栏-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- 左侧栏：标题、白色块、4个彩色方块  weight=1占一半宽度 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!--顶部 Lab1-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lab 1"
            android:textSize="20sp"
            android:gravity="center"
            android:padding="16dp"/>

        <!--白色块：Responsive Layout 1-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Responsive Layout 1"
            android:textSize="18sp"
            android:gravity="center"
            android:background="#FFFFFF"
            android:padding="24dp"/>

        <!--水平LinearLayout：4个等分彩色块-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:text="This"
                android:gravity="center"
                android:background="#ff0000"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:text="is"
                android:gravity="center"
                android:background="#0000ff"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:text="my"
                android:gravity="center"
                android:background="#8040b0"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:text="first"
                android:gravity="center"
                android:background="#ffff00"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 右侧栏：黑色大文本 + 按钮 weight=1占另一半宽度 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!--黑色区域 Android Application，weight=1占剩余高度-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="Android Application"
            android:textSize="18sp"
            android:gravity="center"
            android:background="#000000"
            android:textColor="#FFFFFF"/>

        <!--底部按钮水平布局-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <Button
                android:id="@+id/btnChange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Change"
                android:backgroundTint="#7b68bb"
                android:layout_marginRight="40dp"/>

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:backgroundTint="#7b68bb"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>